# Canfes専用のSupabaseプロジェクト設定。
NEXT_PUBLIC_CANFES_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_CANFES_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Required to create additional operator accounts. Never expose this as NEXT_PUBLIC_*.
CANFES_OPERATOR_INVITE_PASSWORD=replace-with-a-private-invite-password

# Optional. Set this to the URL participants' phones can open when the
# operator screen is on a different device (for example a deployed HTTPS URL).
# NEXT_PUBLIC_CANFES_APP_URL=https://your-casino.example.com

# Optional but recommended for production. Never expose this as NEXT_PUBLIC_*.
# CANFES_SUPABASE_SECRET_KEY=your-server-only-secret-key
